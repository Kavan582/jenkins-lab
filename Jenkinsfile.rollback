pipeline {

    agent any



    parameters {

        string(

            name: 'ROLLBACK_TAG',

            defaultValue: '26',

            description: 'Docker image tag to rollback to'

        )

    }



    stages {



        stage('Pull Rollback Image') {

            steps {

                sh '''

                    docker pull kavan145/jenkins-lab-app:${ROLLBACK_TAG}

                '''

            }

        }



        stage('Deploy Rollback Version') {

            steps {

                sh '''

                    docker rm -f jenkins-lab-app || true



                    docker run -d \

                      --name jenkins-lab-app \

                      -p 8082:80 \

                      kavan145/jenkins-lab-app:${ROLLBACK_TAG}

                '''

            }

        }



        stage('Verify Rollback') {

            steps {

                sh '''

                    sleep 3

                    curl -f http://localhost:8082

                    docker ps | grep jenkins-lab-app

                '''

            }

        }

    }

}
